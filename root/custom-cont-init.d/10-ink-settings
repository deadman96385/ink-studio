#!/bin/bash
set -e
mkdir -p /config/.config/inkscape /config/autosave
mkdir -p /config/.config/gtk-3.0
cp /defaults/ink-touch.css /config/.config/gtk-3.0/gtk.css
if [ ! -f /config/.ink-studio-initialized ]; then
  cp /defaults/ink-preferences.xml /config/.config/inkscape/preferences.xml
  touch /config/.ink-studio-initialized
fi
# The upstream Ink/Stitch package probes Inkscape during installation as root.
# Give the persistent profile back to the desktop user before the GUI starts.
chown -R abc:abc /config/.config/inkscape /config/.cache /config/autosave
chown -R abc:abc /config/.config/gtk-3.0
